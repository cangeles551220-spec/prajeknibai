@model TechServe.Web.Models.DashboardViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Overview";
    ViewData["PageKey"] = "dashboard";
}

<div class="content" id="content"></div>

<div class="modal-backdrop" id="modalBackdrop">
    <section class="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
        <div class="modal-header"><div><p class="eyebrow">Quick action</p><h2 id="modalTitle">New repair job</h2></div><button class="modal-close" id="modalClose">×</button></div>
        <form id="jobForm">
            <div class="form-grid">
                <label>Customer<select id="jobCustomer" required><option value="">Select customer</option></select></label>
                <label>Device<select id="jobDevice" required disabled><option value="">Select customer first</option></select></label>
                <label class="wide">Problem / complaint<textarea id="jobComplaint" required maxlength="500" placeholder="Describe the customer's complaint..."></textarea></label>
                <label>Priority<select id="jobPriority"><option>Normal</option><option>High</option><option>Urgent</option></select></label>
                <label>Expected completion<input type="date" required></label>
                <label>Estimated cost<input id="jobEstimatedCost" type="number" min="0" step="0.01" placeholder="0.00"></label>
                <label>Technician<select id="jobTechnician"><option value="">Unassigned</option></select></label>
            </div>
            <div class="modal-actions"><button type="button" class="button button-ghost" id="modalCancel">Cancel</button><button type="submit" class="button button-primary">Create repair job</button></div>
        </form>
    </section>
</div>

<div class="modal-backdrop" id="customerModalBackdrop">
    <section class="modal" role="dialog" aria-modal="true" aria-labelledby="customerModalTitle">
        <div class="modal-header"><div><p class="eyebrow">Customer management</p><h2 id="customerModalTitle">Add customer</h2></div><button class="modal-close" id="customerModalClose">×</button></div>
        <form id="customerForm">
            <div class="form-grid">
                <label>Full name<input id="customerName" required placeholder="Customer full name"></label>
                <label>Contact number<input id="customerContact" required placeholder="+1 (555) 000-0000"></label>
                <label>Email<input id="customerEmail" type="email" required placeholder="customer@email.com"></label>
                <label class="wide">Address<textarea id="customerAddress" placeholder="Customer address"></textarea></label>
            </div>
            <div class="modal-actions"><button type="button" class="button button-ghost" id="customerModalCancel">Cancel</button><button type="submit" class="button button-primary">Add customer</button></div>
        </form>
    </section>
</div>

<div class="modal-backdrop" id="assignmentModalBackdrop">
    <section class="modal" role="dialog" aria-modal="true" aria-labelledby="assignmentModalTitle">
        <div class="modal-header"><div><p class="eyebrow">Repair assignment</p><h2 id="assignmentModalTitle">Assign technician</h2></div><button class="modal-close" id="assignmentModalClose">×</button></div>
        <form id="assignmentForm">
            <label>Repair job<select id="assignmentJob" required><option value="">Select a repair job</option></select></label>
            <label>Technician<select id="assignmentTechnician" required><option value="">Select a technician</option></select></label>
            <div class="modal-actions"><button type="button" class="button button-ghost" id="assignmentModalCancel">Cancel</button><button type="submit" class="button button-primary">Save assignment</button></div>
        </form>
    </section>
</div>

@Html.AntiForgeryToken()
