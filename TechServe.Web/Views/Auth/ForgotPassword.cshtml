@model TechServe.Web.Models.ForgotPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>TechServe | Reset Password</title>
    <link rel="stylesheet" href="~/css/app.css" />
    <link rel="stylesheet" href="~/css/responsive.css" />
        <link rel="stylesheet" href="~/css/auth.css" />
</head>
<body>
    <div class="login-screen">
        <div class="login-hero">
            <div class="brand-inline">
                <span class="brand-mark-mini">⌁</span>
                <span>TechServe</span>
            </div>

            <div class="hero-scene">
                <div class="live-pill">Live status</div>
                <div class="screen-monitor">
                    <div class="screen-topbar">
                        <span></span><span></span><span></span>
                    </div>
                    <div class="screen-grid">
                        <span></span><span></span><span></span><span></span>
                        <span></span><span></span><span></span><span></span>
                    </div>
                </div>
                <div class="repair-badge">● 3 repairs active</div>
            </div>

            <div class="hero-footer">
                <h2>REPAIR MANAGEMENT PLATFORM</h2>
                <p>Track jobs, manage inventory, and stay on top of every repair — all in one place.</p>
            </div>
        </div>

        <div class="login-panel">
            <div class="login-panel-inner">
                <h1>Reset password</h1>
                <p class="login-subtitle">Enter your registered email to receive a reset code</p>

                <form asp-action="ForgotPassword" asp-controller="Auth" method="post">
                    @Html.AntiForgeryToken()
                    <div class="field-block">
                        <label asp-for="Email">Registered email</label>
                        <input asp-for="Email" type="email" placeholder="Enter your email" autocomplete="email" required />
                    </div>

                    @if (Model?.CodeSent == true)
                    {
                        <div class="field-block">
                            <label asp-for="ResetCode">Reset code</label>
                            <input asp-for="ResetCode" inputmode="numeric" autocomplete="one-time-code" placeholder="6-digit code" required />
                        </div>
                        <div class="field-block">
                            <label asp-for="NewPassword">New password</label>
                            <div class="password-field"><input asp-for="NewPassword" type="password" autocomplete="new-password" placeholder="Enter new password" required /><button type="button" class="password-toggle" data-password-target="NewPassword" aria-label="Show password" title="Show password">◉</button></div>
                        </div>
                        <div class="field-block">
                            <label asp-for="ConfirmPassword">Confirm password</label>
                            <div class="password-field"><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" placeholder="Re-enter new password" required /><button type="button" class="password-toggle" data-password-target="ConfirmPassword" aria-label="Show password" title="Show password">◉</button></div>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model?.ErrorMessage))
                    {
                        <div class="login-error">@Model.ErrorMessage</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model?.SuccessMessage))
                    {
                        <div class="login-success">@Model.SuccessMessage</div>
                    }

                    <button type="submit" class="button button-primary login-button">@(Model?.CodeSent == true ? "Create new password" : "Send reset code")</button>
                </form>

                <div class="login-mode">
                    <span>Back to <a asp-action="Login" asp-controller="Auth" class="login-register">Login</a></span>
                </div>

                <div class="copyright">© 2026 TechServe · All rights reserved</div>
            </div>
        </div>
    </div>
</body>
<script src="~/js/auth.js"></script>
</html>
