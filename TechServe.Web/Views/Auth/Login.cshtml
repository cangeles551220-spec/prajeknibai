@model TechServe.Web.Models.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>TechServe | Login</title>
    <link rel="stylesheet" href="~/css/app.css" />
    <link rel="stylesheet" href="~/css/responsive.css" />
        <link rel="stylesheet" href="~/css/auth.css?v=remember-me-layout-1" />
</head>
<body>
    <div class="login-screen">
        <a class="login-hero" href="/" aria-label="Go to the TechServe landing page">
            <div class="brand-inline">
                <span class="brand-mark-mini">⌁</span>
                <span>TechServe</span>
            </div>

            <div class="hero-scene">
                <div class="live-pill">Live status</div>
                <div class="screen-monitor">
                    <div class="screen-topbar">
                        <span></span><span></span><span></span>
                    </div>
                    <div class="screen-grid">
                        <span></span><span></span><span></span><span></span>
                        <span></span><span></span><span></span><span></span>
                    </div>
                </div>
                <div class="repair-badge">● 3 repairs active</div>
            </div>

            <div class="hero-footer">
                <h2>REPAIR MANAGEMENT PLATFORM</h2>
                <p>Track jobs, manage inventory, and stay on top of every repair — all in one place.</p>
            </div>
        </a>

        <div class="login-panel">
            <div class="login-panel-inner">
                <h1>Welcome back</h1>
                <p class="login-subtitle">Log in to manage your shop</p>

                <form asp-action="Login" asp-controller="Auth" method="post">
                    @Html.AntiForgeryToken()
                    <div class="field-block">
                        <label asp-for="Username">Email or username</label>
                        <input asp-for="Username" type="text" placeholder="Enter email or username" autocomplete="username" required />
                    </div>

                    <div class="field-block password-block">
                        <div class="label-row">
                            <label asp-for="Password">Password</label>
                            <a asp-action="ForgotPassword" asp-controller="Auth" class="text-link">Forgot password?</a>
                        </div>
                        <div class="password-field"><input asp-for="Password" type="password" placeholder="Enter password" autocomplete="current-password" required /><button type="button" class="password-toggle" data-password-target="Password" aria-label="Show password" title="Show password">◉</button></div>
                    </div>

                    <label class="remember-me"><input asp-for="RememberMe" type="checkbox" /> <span>Remember Me</span></label>

                    @if (!string.IsNullOrWhiteSpace(Model?.SuccessMessage))
                    {
                        <div class="login-success">@Model.SuccessMessage</div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model?.ErrorMessage))
                    {
                        <div class="login-error">@Model.ErrorMessage</div>
                    }

                    <button type="submit" class="button button-primary login-button">Sign in</button>
                </form>

                <div class="copyright">© 2026 TechServe · All rights reserved</div>
            </div>
        </div>
    </div>
</body>
<script src="~/js/auth.js"></script>
</html>
