@model TechServe.Web.Models.InvitationSetupViewModel
@{ Layout = null; }
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>TechServe | Set Password</title><link rel="stylesheet" href="~/css/app.css" /><link rel="stylesheet" href="~/css/auth.css" /></head><body><div class="login-screen"><div class="login-panel" style="margin:auto"><div class="login-panel-inner"><h1>Set your password</h1><p class="login-subtitle">Use a password of at least 8 characters.</p><form asp-action="SetPassword" method="post">@Html.AntiForgeryToken()<input asp-for="Token" type="hidden" /><div class="field-block"><label asp-for="Password">Password</label><input asp-for="Password" type="password" autocomplete="new-password" required /></div><div class="field-block"><label asp-for="ConfirmPassword">Confirm password</label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required /></div>@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="login-error">@Model.ErrorMessage</div> }<button type="submit" class="button button-primary login-button">Set password</button></form></div></div></div></body></html>