@model List<TechServe.Web.Models.CustomerViewModel>

@{
    ViewData["Title"] = "Customers";
}

<div class="panel">
    <div class="panel-header">
        <div>
            <h3>Customers</h3>
            <p>Customer contact and status records.</p>
        </div>
        <button class="button button-primary">＋ Add customer</button>
    </div>

    <div class="table-toolbar">
        <input type="search" class="table-search" placeholder="Search customers..." aria-label="Search customers" />
    </div>

    <div class="table-wrap">
        <table class="data-table searchable-table">
            <thead>
                <tr>
                    <th>Customer</th>
                    <th>Customer ID</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var customer in Model)
                {
                    <tr>
                        <td><b>@customer.Name</b></td>
                        <td>@customer.CustomerId</td>
                        <td>@customer.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
