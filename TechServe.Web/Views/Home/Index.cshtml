@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>TechServe | Repair operations</title>
    <link rel="icon" type="image/png" href="~/images/techserve-logo.png" />
    <link rel="stylesheet" href="~/css/app.css" />
    <link rel="stylesheet" href="~/css/landing-responsive.css?v=2" />
</head>
<body class="landing-body">
    <div class="landing-page">
        <header class="landing-header">
            <div class="landing-brand">
                <span class="brand-mark-mini">⌁</span>
                <span>TechServe</span>
            </div>
            <nav class="landing-nav">
                <a href="#features">Features</a>
                <a href="#workflow">Workflow</a>
                <a href="#pricing">Pricing</a>
            </nav>
            <div class="landing-actions">
                <a class="button button-ghost" asp-controller="Auth" asp-action="Login">Login</a>
                <a class="button button-primary" asp-controller="Auth" asp-action="Login">Get started</a>
            </div>
        </header>

        <main>
            <section class="landing-hero">
                <div class="landing-copy">
                    <span class="eyebrow">All-in-one repair operations</span>
                    <h1>Run your repair shop with real-time visibility.</h1>
                    <p>Track every repair job, manage technicians, monitor inventory, and keep customers informed from one streamlined dashboard.</p>
                    <div class="landing-cta">
                        <a class="button button-primary" asp-controller="Auth" asp-action="Login">Book a demo</a>
                        <a class="button button-ghost" asp-controller="Auth" asp-action="Login">Sign in</a>
                    </div>
                    <ul class="landing-proof">
                        <li>3 active jobs today</li>
                        <li>99.9% service visibility</li>
                        <li>24/7 operations tracking</li>
                    </ul>
                </div>

                <div class="landing-visual">
                    <div class="dashboard-card large">
                        <div class="card-head">
                            <span class="dot red"></span>
                            <span class="dot amber"></span>
                            <span class="dot green"></span>
                        </div>
                        <div class="chart-box">
                            <div class="bars">
                                <span style="height: 28%"></span>
                                <span style="height: 46%"></span>
                                <span style="height: 62%"></span>
                                <span style="height: 78%"></span>
                                <span style="height: 55%"></span>
                                <span style="height: 90%"></span>
                            </div>
                        </div>
                        <div class="metrics-row">
                            <div><small>Revenue</small><strong>₱96.8K</strong></div>
                            <div><small>Repairs</small><strong>128</strong></div>
                            <div><small>Uptime</small><strong>98.4%</strong></div>
                        </div>
                    </div>
                    <div class="dashboard-card small">
                        <p>Inventory alert</p>
                        <strong>3 low-stock items</strong>
                    </div>
                </div>
            </section>

            <section id="features" class="landing-section">
                <div class="section-heading">
                    <span class="eyebrow">Why TechServe</span>
                    <h2>Built for modern repair businesses.</h2>
                </div>
                <div class="feature-grid">
                    <article class="feature-card">
                        <div class="icon">▣</div>
                        <h3>Repair job tracking</h3>
                        <p>Monitor status, priorities, technician assignments, and completion timelines from one dashboard.</p>
                    </article>
                    <article class="feature-card">
                        <div class="icon">◉</div>
                        <h3>Live service visibility</h3>
                        <p>See what’s active, delayed, or ready for pickup without digging through spreadsheets.</p>
                    </article>
                    <article class="feature-card">
                        <div class="icon">▥</div>
                        <h3>Inventory control</h3>
                        <p>Stay ahead of stockouts and supplier needs with automated stock tracking and alerts.</p>
                    </article>
                    <article class="feature-card">
                        <div class="icon">₱</div>
                        <h3>Billing & reporting</h3>
                        <p>Keep payment records, customer billing, and operational insights organized in a single view.</p>
                    </article>
                </div>
            </section>

            <section id="workflow" class="landing-section workflow-section">
                <div class="section-heading">
                    <span class="eyebrow">Workflow</span>
                    <h2>From intake to completed repair.</h2>
                </div>

                <div class="workflow-steps">
                    <div class="step">
                        <span>01</span>
                        <h3>Receive</h3>
                        <p>Create a repair request and record device details.</p>
                    </div>
                    <div class="step">
                        <span>02</span>
                        <h3>Assign</h3>
                        <p>Route the job to the right technician and set the priority.</p>
                    </div>
                    <div class="step">
                        <span>03</span>
                        <h3>Repair</h3>
                        <p>Track updates, parts, and progress across every stage.</p>
                    </div>
                    <div class="step">
                        <span>04</span>
                        <h3>Deliver</h3>
                        <p>Close the job, invoice the customer, and keep the record complete.</p>
                    </div>
                </div>
            </section>

            <section id="pricing" class="landing-section pricing-section">
                <div class="cta-panel">
                    <div>
                        <span class="eyebrow">Ready to operate smarter?</span>
                        <h2>Launch your repair workflow in minutes.</h2>
                    </div>
                    <a class="button button-primary" asp-controller="Auth" asp-action="Login">Open dashboard</a>
                </div>
            </section>
        </main>

        <footer class="landing-footer">
            <span>© 2026 TechServe</span>
            <span>Repair operations platform</span>
        </footer>
    </div>
</body>
</html>

