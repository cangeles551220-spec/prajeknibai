@{
    ViewData["Title"] = "Reports";
}

<div class="dashboard-grid">
    <section class="panel">
        <div class="panel-header">
            <div>
                <h3>Revenue Summary</h3>
                <p>Current operational performance.</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-top">Total revenue <span class="stat-icon i-blue">₱</span></div>
            <h2>$@ViewBag.Revenue</h2>
        </div>
    </section>

    <section class="panel">
        <div class="panel-header">
            <div>
                <h3>Completed Repairs</h3>
                <p>Repair throughput for the service team.</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-top">Completed <span class="stat-icon i-green">✓</span></div>
            <h2>@ViewBag.CompletedRepairs</h2>
        </div>
    </section>
</div>
